{
  "name": "@morecatlab/jl-moodle-session",
  "version": "0.1.1",
  "description": "JupyterLite frontend extension that reads the Moodle LTI session.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build:prod": "npm run clean && npm run build:lib && npm run build:labextension",
    "build:lib": "tsc",
    "build:labextension": "jupyter labextension build .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "4.5.1",
    "@jupyterlab/statusbar": "4.5.1",
    "@lumino/widgets": "^2.7.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.10",
    "rimraf": "5.0.0",
    "typescript": "5.7.2"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "_build": {
      "load": "static/remoteEntry.674031260d49ac62c85b.js",
      "extension": "./extension"
    }
  }
}
