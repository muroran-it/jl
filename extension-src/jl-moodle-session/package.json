{
  "name": "@morecatlab/jl-moodle-session",
  "version": "0.1.2",
  "description": "JupyterLite frontend extension that reads the Moodle LTI session and shows it in the status bar.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build:lib": "tsc",
    "build:labextension": "jupyter-builder build --core-version=4.5.1 .",
    "build": "npm run build:lib && npm run build:labextension",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "4.5.1",
    "@jupyterlab/statusbar": "4.5.1",
    "@lumino/widgets": "^2.7.1"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.0.0",
    "rimraf": "5.0.0",
    "typescript": "5.7.2"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension"
  }
}